{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-retrieval:confirmed-terms-execution:1",
  "title": "Owner-confirmed term execution and candidate intake delegation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_ref",
        "binding_ids",
        "max_calls",
        "max_hit_slots",
        "policy_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "confirmed-terms-execution@1"
        },
        "workflow_ref": {
          "const": "confirmed-terms-retrieval@1"
        },
        "binding_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_hit_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_ref",
        "binding_ids",
        "max_calls",
        "max_hit_slots",
        "policy_digest",
        "candidate_intake"
      ],
      "properties": {
        "schema_version": {
          "const": "confirmed-terms-execution@2"
        },
        "workflow_ref": {
          "const": "confirmed-terms-retrieval@1"
        },
        "binding_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_hit_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidate_intake": {
          "enum": [
            "auto",
            "manual"
          ]
        }
      }
    }
  ]
}
